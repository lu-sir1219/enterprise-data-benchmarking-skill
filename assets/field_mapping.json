{
  "description": "数据字段到业务指标的映射配置",
  "version": "1.0",
  "mapping_strategy": {
    "priority": [
      "exact_match",
      "fuzzy_match",
      "inference"
    ],
    "fuzzy_threshold": 0.6,
    "inference_rules": [
      {
        "condition": "字段名包含 'user' 或 'customer' 或 'member'",
        "inference": "用户相关指标",
        "examples": ["user_id", "customer_id", "member_id"]
      },
      {
        "condition": "字段名包含 'pay' 或 'price' 或 'amount' 或 'cost'",
        "inference": "交易相关指标",
        "examples": ["pay_amount", "price", "cost"]
      },
      {
        "condition": "字段名包含 'order' 或 'sale' 或 'sales'",
        "inference": "订单/销售相关指标",
        "examples": ["order_id", "sale_amount", "sales_count"]
      },
      {
        "condition": "字段名包含 'date' 或 'time' 或 'day' 或 'month'",
        "inference": "时间相关指标",
        "examples": ["order_date", "create_time", "day"]
      },
      {
        "condition": "字段名包含 'product' 或 'item' 或 'sku'",
        "inference": "商品相关指标",
        "examples": ["product_id", "item_id", "sku"]
      },
      {
        "condition": "字段名包含 'stock' 或 'inventory' 或 'warehouse'",
        "inference": "库存相关指标",
        "examples": ["stock_qty", "inventory_count", "warehouse_id"]
      },
      {
        "condition": "字段名包含 'rate' 或 'ratio' 或 'percent' 或 '%'",
        "inference": "比率相关指标",
        "examples": ["conversion_rate", "growth_ratio", "profit_percent"]
      },
      {
        "condition": "字段名包含 'score' 或 'grade' 或 'level'",
        "inference": "评分/等级相关指标",
        "examples": ["user_score", "grade", "level"]
      }
    ]
  },
