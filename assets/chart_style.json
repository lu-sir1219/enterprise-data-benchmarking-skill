{
  "global": {
    "title": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 18,
      "font_color": "#333333",
      "font_weight": "bold"
    },
    "subtitle": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 14,
      "font_color": "#666666",
      "font_weight": "normal"
    },
    "legend": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 12,
      "font_color": "#333333",
      "position": "top",
      "align": "left"
    },
    "tooltip": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 12,
      "background_color": "rgba(255, 255, 255, 0.95)",
      "border_color": "#667eea",
      "border_width": 1
    }
  },
  
  "colors": {
    "primary": "#667eea",
    "secondary": "#764ba2",
    "success": "#28a745",
    "warning": "#ffc107",
    "danger": "#dc3545",
    "info": "#17a2b8",
    "dark": "#333333",
    "light": "#f5f7fa",
    "grid": "#e0e0e0"
  },
  
  "charts": {
    "bar": {
      "default_color": "#667eea",
      "colors": ["#667eea", "#764ba2", "#28a745", "#ffc107", "#dc3545"],
      "bar_width": 0.6,
      "bar_gap": "10%",
      "bar_group_gap": "20%",
      "show_value": true,
      "value_font_size": 12,
      "value_color": "#333333",
      "value_position": "top",
      "border_radius": 4,
      "border_color": "#ffffff",
      "border_width": 1
    },
    
    "line": {
      "default_color": "#667eea",
      "colors": ["#667eea", "#764ba2", "#28a745", "#ffc107", "#dc3545"],
      "line_width": 2,
      "line_type": "solid",
      "line_shape": "spline",
      "marker_size": 8,
      "marker_color": "#ffffff",
      "marker_border_color": "#667eea",
      "marker_border_width": 2,
      "fill_area": false,
      "fill_color": "rgba(102, 126, 234, 0.1)"
    },
    
    "scatter": {
      "default_color": "#667eea",
      "colors": ["#667eea", "#764ba2", "#28a745", "#ffc107", "#dc3545"],
      "marker_size": 12,
      "marker_opacity": 0.8,
      "marker_symbol": "circle",
      "show_trendline": false,
      "trendline_color": "#667eea",
      "trendline_width": 2,
      "trendline_type": "linear"
    },
    
    "pie": {
      "default_color": "#667eea",
      "colors": ["#667eea", "#764ba2", "#28a745", "#ffc107", "#dc3545", "#17a2b8", "#6c757d"],
      "hole_size": 0,
      "show_percentage": true,
      "percentage_font_size": 14,
      "percentage_color": "#ffffff",
      "show_label": true,
      "label_font_size": 12,
      "label_color": "#333333",
      "label_position": "outside",
      "sort_by_value": true,
      "start_angle": 0
    },
    
    "radar": {
      "default_color": "#667eea",
      "colors": ["#667eea", "#764ba2", "#28a745", "#ffc107", "#dc3545"],
      "line_width": 2,
      "line_color": "#667eea",
      "fill_area": true,
      "fill_color": "rgba(102, 126, 234, 0.3)",
      "marker_size": 6,
      "marker_color": "#ffffff",
      "grid_level": 5,
      "grid_color": "#e0e0e0",
      "grid_width": 1
    },
    
    "waterfall": {
      "positive_color": "#28a745",
      "negative_color": "#dc3545",
      "total_color": "#667eea",
      "connector_color": "#667eea",
      "connector_width": 2,
      "show_value": true,
      "value_font_size": 12,
      "value_color": "#333333"
    },
    
    "dashboard": {
      "grid_rows": 2,
      "grid_cols": 2,
      "spacing": 20,
      "chart_height": 300,
      "chart_width": "100%",
      "title_font_size": 16,
      "title_color": "#333333"
    }
  },
  
  "layout": {
    "margin": {
      "top": 60,
      "right": 30,
      "bottom": 60,
      "left": 80
    },
    "padding": 20,
    "width": 800,
    "height": 500,
    "responsive": true,
    "min_width": 300,
    "min_height": 300
  },
  
  "axis": {
    "x": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 12,
      "font_color": "#666666",
      "font_weight": "normal",
      "title_font_size": 14,
      "title_color": "#333333",
      "title_font_weight": "bold",
      "grid_color": "#e0e0e0",
      "grid_width": 1,
      "line_color": "#666666",
      "line_width": 1,
      "tick_angle": 0,
      "tick_max_count": 10
    },
    "y": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 12,
      "font_color": "#666666",
      "font_weight": "normal",
      "title_font_size": 14,
      "title_color": "#333333",
      "title_font_weight": "bold",
      "grid_color": "#e0e0e0",
      "grid_width": 1,
      "line_color": "#666666",
      "line_width": 1,
      "tick_angle": 0,
      "tick_max_count": 8,
      "tick_prefix": "",
      "tick_suffix": ""
    },
    "z": {
      "font_family": "Microsoft YaHei, Arial, sans-serif",
      "font_size": 12,
      "font_color": "#666666",
      "font_weight": "normal"
    }
  },
  
  "annotations": {
    "font_family": "Microsoft YaHei, Arial, sans-serif",
    "font_size": 12,
    "font_color": "#666666",
    "font_weight": "normal",
    "background_color": "rgba(255, 255, 255, 0.9)",
    "border_color": "#667eea",
    "border_width": 1,
    "border_radius": 4,
    "opacity": 0.9
  },
  
  "templates": {
    "default": {
      "title": "企业数据对标分析",
      "subtitle": "基于行业最佳实践的分析报告",
      "color_scheme": "default",
      "chart_style": "modern"
    },
    "professional": {
      "title": "企业数据对标分析报告",
      "subtitle": "专业版 - 基于行业最佳实践",
      "color_scheme": "professional",
      "chart_style": "clean"
    },
    "minimal": {
      "title": "对标分析",
      "subtitle": "数据驱动决策",
      "color_scheme": "monochrome",
      "chart_style": "minimal"
    }
  },
  
  "export": {
    "default_format": "png",
    "formats": ["png", "jpg", "svg", "pdf"],
    "resolution": 2,
    "width": 1200,
    "height": 800,
    "background_color": "#ffffff"
  }
}
